# Copy to `.env.local` and fill in values.

# Admin panel — required for /admin/sign-in
NEXT_PUBLIC_SUPABASE_URL=https://bomyidlpzinhemztpkdj.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xme-AMtg5nhUIcF8QgmxQw_ckK_UpEw
# Server-side uploads use Supabase Storage. Prefer a service role key in production
# so uploads do not depend on public bucket insert policies.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=uploads
ADMIN_PASSWORD=TAKEMJIM

# Recommended in production: long random string used to sign the httpOnly session cookie.
# If omitted, a stable key is derived from ADMIN_PASSWORD (okay for local development).
ADMIN_SESSION_SECRET=

# Optional: authorize GET /api/admin/messages and other admin APIs from scripts / CI.
# Send header: Authorization: Bearer <ADMIN_API_SECRET>
ADMIN_API_SECRET=

# Contact form email notifications. The form still saves to /admin/messages if email is not configured.
CONTACT_NOTIFY_EMAIL=takemjim43@gmail.com
RESEND_API_KEY=
# Use a verified sender/domain in Resend for production, for example:
# RESEND_FROM=Takem Jim Portfolio <hello@takemjim.com>
RESEND_FROM=Portfolio <onboarding@resend.dev>
